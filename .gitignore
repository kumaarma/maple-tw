# === 絕對不能上傳 ===
# API 金鑰明文
apikey.txt

# 快取與用量計數（含查詢過的角色資料）
cache.json
cache.json.tmp
quota.json

# wrangler 的本機快取，含 Cloudflare 帳號 ID 與帳號名稱（帳號名可能是 email）
.wrangler/

# 測試用的離線資料，從 cache.json 產生，同樣含角色資料
tools/fixtures.js
# 測試產生的測試頁與截圖
tools/.work/

# === 一般忽略 ===
__pycache__/
*.pyc
.DS_Store
Thumbs.db
.vscode/
.idea/
